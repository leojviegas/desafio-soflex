# Entorno y servidor Back-End
NODE_ENV=development
PORT=3001

# Persistencia SQLite y dataset CSV de referencia
DATABASE_PATH=./data/soflex-copilot.db
DATASET_CSV_PATH=

# Configuración Dual-Provider de IA
# Valores soportados: mock | gemini | ollama | openai | openai-compatible
LLM_PROVIDER=mock
# Opcional: sobrescribe el modelo por defecto del proveedor (ej: gemini-2.5-flash, qwen2.5:7b, gpt-4o-mini)
LLM_MODEL=
# URL base opcional para ollama (default http://localhost:11434/api) u obligatoria para openai-compatible
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=15000
LLM_FALLBACK_TO_MOCK=true

# Credenciales para Modo Real
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
